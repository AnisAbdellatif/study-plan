# Copy to .env next to compose.yaml on the VPS and fill in. Never commit the real file.

# Where the app is reachable. Point the domain's A/AAAA records at the VPS before the first start.
DOMAIN=plan.example.org

# Image pushed by CI, lower case: ghcr.io/<owner>/<repository>. The deploy job also passes it in.
APP_IMAGE=ghcr.io/owner/study-plan

# PostgreSQL. Use a URL-safe password, e.g. from `openssl rand -hex 32`.
POSTGRES_PASSWORD=
POSTGRES_USER=studyplan
POSTGRES_DB=studyplan

# At least 32 random characters, e.g. from `openssl rand -base64 32`. Changing it signs everyone out.
BETTER_AUTH_SECRET=

# Mail delivery for verification, password reset and reminder e-mails.
SMTP_URL=smtps://user:password@mail.example.org:465
MAIL_FROM=Studienplaner <noreply@plan.example.org>

# The superadmin account, created on the first start only. Sign in and change the password afterwards
# (account page → password reset); later changes here have no effect on the existing account.
SUPERADMIN_EMAIL=admin@plan.example.org
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Superadmin

REMINDER_INTERVAL_MINUTES=60
