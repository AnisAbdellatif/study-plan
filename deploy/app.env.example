# The app's secrets, on the VPS only: /opt/study-plan/app.env (production) and /opt/study-plan-dev/app.env (dev),
# readable by the deploy user only (chmod 600). Never commit the real files. Docker hands this file to the app
# container as it is (config/deploy.<destination>.yml, env-file): no quotes around values, they would be kept, and
# `$` needs no escaping. Settings that aren't secret (NODE_ENV, PUBLIC_URL, REMINDER_INTERVAL_MINUTES) are in
# config/deploy*.yml. Changes take effect with the next deploy, or `kit kamal app boot -d <destination>`.
# Use different values for dev: its own database, sessions and superadmin.

# PostgreSQL, the accessory of the same destination: host study-plan-postgres (dev: study-plan-dev-postgres), with
# POSTGRES_PASSWORD from postgres.env next to this file. Use a URL-safe password, e.g. from `openssl rand -hex 32`.
DATABASE_URL=postgres://studyplan:<password>@study-plan-postgres:5432/studyplan

# At least 32 random characters, e.g. from `openssl rand -base64 32`. Changing it signs everyone out.
BETTER_AUTH_SECRET=

# Mail delivery for verification, password reset and reminder e-mails.
SMTP_URL=smtps://user:password@mail.example.org:465
MAIL_FROM=Studienplaner <noreply@study-plan.de>
# Mailbox the contact form writes to; replies go to the sender through Reply-To. Empty: contact@study-plan.de.
CONTACT_EMAIL=

# The superadmin account, created on the first start only. Sign in and change the password afterwards
# (account page → password reset); later changes here have no effect on the existing account.
SUPERADMIN_EMAIL=admin@study-plan.de
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Superadmin

# Optional study assistant through OpenRouter (https://openrouter.ai). Leave empty to turn it off.
# Only programme data and questions reach the model, never grades.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
