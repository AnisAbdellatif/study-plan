# Obtains and renews the TLS certificates automatically. No access log is written, matching the retention stated
# in the privacy policy; add a `log` block here if you want one.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000
}

# The dev stack (compose.dev.yaml) joins the shared study-plan-proxy network under this name. While it is not
# running, this domain answers 502. Search engines are asked not to index it.
{$DEV_DOMAIN} {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy study-plan-dev-app:3000
}
