# Copy to .env next to compose.yaml in DEV_DEPLOY_PATH (e.g. /opt/study-plan-dev) on the VPS and fill in.
# Use values different from production: the dev stack has its own database, sessions and superadmin.
# In .env, wrap values containing $ in single quotes.

# Must match DEV_DOMAIN in the production .env, where Caddy serves it.
DOMAIN=dev.plan.example.org

# Same image as production; the dev branch is pushed with the tags dev and dev-<commit>.
APP_IMAGE=ghcr.io/owner/study-plan

POSTGRES_PASSWORD=
POSTGRES_USER=studyplan
POSTGRES_DB=studyplan

# A different secret than production, e.g. from `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

SMTP_URL=smtps://user:password@mail.example.org:465
MAIL_FROM=Studienplaner (dev) <noreply@plan.example.org>

SUPERADMIN_EMAIL=admin@plan.example.org
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Superadmin

# Off by default, so test data never e-mails reminders. Set to 60 to test them.
REMINDER_INTERVAL_MINUTES=0
