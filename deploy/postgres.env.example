# PostgreSQL's password, on the VPS only: /opt/study-plan/postgres.env (production) and
# /opt/study-plan-dev/postgres.env (dev), chmod 600, next to app.env. The same password as in app.env's DATABASE_URL.
# Only used when the database is created on an empty volume; the password of an existing database stays as it was.
# No quotes around the value (Docker reads this file as it is).
POSTGRES_PASSWORD=
