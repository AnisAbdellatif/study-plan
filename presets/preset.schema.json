{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+\\/[a-z0-9-]+$"
    },
    "university": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "slug",
        "name"
      ]
    },
    "programme": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "degree": {
          "type": "string",
          "enum": [
            "bsc",
            "msc"
          ]
        }
      },
      "required": [
        "slug",
        "name",
        "degree"
      ]
    },
    "poVersion": {
      "type": "string",
      "minLength": 1
    },
    "handbookVersion": {
      "type": "string",
      "minLength": 1
    },
    "standardSemesters": {
      "type": "integer",
      "minimum": 1,
      "maximum": 14
    },
    "totalCredits": {
      "type": "number",
      "minimum": 0
    },
    "creditLabel": {
      "type": "string",
      "enum": [
        "ECTS",
        "LP",
        "CP"
      ]
    },
    "notes": {
      "type": "string"
    },
    "gradeRules": {
      "type": "object",
      "properties": {
        "allowedValues": {
          "minItems": 2,
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          }
        },
        "passThreshold": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "attemptSelection": {
          "type": "string",
          "enum": [
            "best",
            "latest"
          ]
        },
        "finalRounding": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "truncate",
                "round_half_up",
                "round_to_nearest_allowed_ties_better"
              ]
            },
            "precision": {
              "anyOf": [
                {
                  "type": "number",
                  "const": 1
                },
                {
                  "type": "number",
                  "const": 2
                }
              ]
            }
          },
          "required": [
            "mode",
            "precision"
          ]
        },
        "aggregation": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "allowedValues",
        "passThreshold",
        "attemptSelection",
        "finalRounding",
        "aggregation"
      ]
    },
    "modules": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "credits": {
            "type": "number",
            "minimum": 0
          },
          "grading": {
            "type": "string",
            "enum": [
              "graded",
              "pass_fail"
            ]
          },
          "countsTowardAverage": {
            "type": "boolean"
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "offering": {
            "type": "string",
            "enum": [
              "winter",
              "summer",
              "both"
            ]
          },
          "typicalSemester": {
            "type": "integer",
            "minimum": 1,
            "maximum": 14
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "code",
          "name",
          "credits",
          "grading",
          "countsTowardAverage",
          "category",
          "offering"
        ]
      }
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "minCredits": {
            "type": "number",
            "minimum": 0
          },
          "maxCredits": {
            "type": "number",
            "minimum": 0
          },
          "moduleCodes": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name",
          "minCredits",
          "moduleCodes"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "university",
    "programme",
    "poVersion",
    "handbookVersion",
    "standardSemesters",
    "totalCredits",
    "creditLabel",
    "gradeRules",
    "modules",
    "areas"
  ],
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "weightMode": {
          "type": "string",
          "enum": [
            "credits",
            "fixed"
          ]
        },
        "roundResult": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "truncate",
                "round_half_up",
                "round_to_nearest_allowed_ties_better"
              ]
            },
            "precision": {
              "anyOf": [
                {
                  "type": "number",
                  "const": 1
                },
                {
                  "type": "number",
                  "const": 2
                }
              ]
            }
          },
          "required": [
            "mode",
            "precision"
          ]
        },
        "dropWorst": {
          "type": "object",
          "properties": {
            "maxCredits": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "maxCredits"
          ]
        },
        "children": {
          "minItems": 1,
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "module"
                  },
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "factor": {
                    "anyOf": [
                      {
                        "type": "number",
                        "const": 0
                      },
                      {
                        "type": "number",
                        "const": 0.5
                      },
                      {
                        "type": "number",
                        "const": 1
                      },
                      {
                        "type": "number",
                        "const": 2
                      }
                    ]
                  },
                  "weight": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "kind",
                  "code"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "group"
                  },
                  "weight": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "node": {
                    "$ref": "#/$defs/__schema0"
                  }
                },
                "required": [
                  "kind",
                  "node"
                ]
              }
            ]
          }
        }
      },
      "required": [
        "id",
        "weightMode",
        "children"
      ]
    }
  }
}
