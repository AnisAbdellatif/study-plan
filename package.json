{
  "name": "study-plan",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/shared && tsc -p apps/web && tsc -p apps/api",
    "lint": "biome check .",
    "format": "biome check --write .",
    "dev": "bun run --filter '@study-plan/*' dev",
    "build": "bun run --filter @study-plan/web build",
    "db:generate": "bun run --filter @study-plan/api db:generate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^24.0.0",
    "fast-check": "^4.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
